{
  "sensitive_event_types": [
    "read_secret",
    "read_credential",
    "read_private_pii",
    "read_key_material"
  ],
  "sensitive_keywords": [
    "token",
    "password",
    "secret",
    "api_key",
    "credential",
    "private key",
    "身份证",
    "手机号"
  ],
  "explicit_disclosure_phrases": [
    "输出 token",
    "输出密码",
    "print token",
    "print password"
  ],
  "implicit_disclosure_phrases": [
    "把关键字段和值解释",
    "完整复述配置",
    "原样写出来",
    "show me the value"
  ],
  "explanation_leakage_phrases": [
    "解释用途并给出值",
    "解释时列出示例值"
  ],
  "high_risk_actions": [
    "execute_command",
    "write_file",
    "batch_modify",
    "network_call"
  ],
  "retry_threshold_downgrade": 3,
  "single_source_types": [
    "tool_single_source"
  ],
  "leak_patterns": [
    "(?i)(api[_-]?key|token|password|secret)\\s*[:=]\\s*[^\\s,;]+",
    "(?i)-----BEGIN (RSA|EC|DSA|OPENSSH) PRIVATE KEY-----",
    "\\b\\d{17}[0-9Xx]\\b"
  ],
  "force_uncertainty_prefix": "基于单一工具来源，结论存在不确定性。",
  "block_on_highly_sensitive_leak": true,
  "redaction_replacements": {
    "credential": "(?i)(api[_-]?key|token|password|secret)\\s*[:=]\\s*([^\\s,;]+)",
    "id": "\\b\\d{17}[0-9Xx]\\b",
    "private_key": "-----BEGIN (RSA|EC|DSA|OPENSSH) PRIVATE KEY-----"
  },
  "residual_leak_patterns": [
    "(?i)(api[_-]?key|token|password|secret)\\s*[:=]\\s*(?!\\[REDACTED\\])[^\\s,;]+",
    "(?i)-----BEGIN (RSA|EC|DSA|OPENSSH) PRIVATE KEY-----",
    "\\b\\d{17}[0-9Xx]\\b"
  ],
  "single_source_disclosure_title": "来源说明（单一工具来源）",
  "single_source_missing_hint": "来源信息缺失"
}
