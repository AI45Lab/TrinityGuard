# TrinityGuard LLM Configuration
# Copy this file to .env and fill in your API keys

# MAS LLM (used by the agents being tested)
MAS_LLM_PROVIDER=openai
MAS_LLM_MODEL=gpt-4o-mini
MAS_LLM_API_KEY=sk-your-key-here
MAS_LLM_BASE_URL=https://api.openai.com/v1

# Monitor/Judge LLM (used by TrinityGuard for evaluation)
# Recommended: use a DIFFERENT and STRONGER model than MAS
JUDGE_LLM_PROVIDER=openai
JUDGE_LLM_MODEL=gpt-4o
JUDGE_LLM_API_KEY=sk-your-key-here
JUDGE_LLM_BASE_URL=https://api.openai.com/v1
