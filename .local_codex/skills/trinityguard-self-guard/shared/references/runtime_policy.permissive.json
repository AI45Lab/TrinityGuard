{
  "sensitive_event_types": ["read_secret", "read_credential", "read_private_pii", "read_key_material"],
  "sensitive_keywords": ["token", "password", "secret", "api_key", "credential", "private key"],
  "explicit_disclosure_phrases": ["输出 token", "输出密码", "print token", "print password"],
  "high_risk_actions": ["execute_command", "write_file", "batch_modify", "network_call"],
  "retry_threshold_downgrade": 5,
  "single_source_types": ["tool_single_source"],
  "leak_patterns": [
    "(?i)(api[_-]?key|token|password|secret)\\s*[:=]\\s*[^\\s,;]+",
    "(?i)-----BEGIN (RSA|EC|DSA|OPENSSH) PRIVATE KEY-----"
  ],
  "force_uncertainty_prefix": "结论基于有限证据。",
  "block_on_highly_sensitive_leak": false,
  "redaction_replacements": {
    "credential": "(?i)(api[_-]?key|token|password|secret)\\s*[:=]\\s*([^\\s,;]+)",
    "id": "\\b\\d{17}[0-9Xx]\\b",
    "private_key": "-----BEGIN (RSA|EC|DSA|OPENSSH) PRIVATE KEY-----"
  }
}
